#!/bin/sh
set -eu

cd /
if [ -n "${ONECREW_CONTAINER_RUNTIME:-}" ]; then
  runtime=$ONECREW_CONTAINER_RUNTIME
else
  runtime=$(command -v docker) || {
    printf '%s\n' 'Docker CLI is unavailable. Set ONECREW_CONTAINER_RUNTIME to the absolute path of a Docker-compatible CLI.' >&2
    exit 127
  }
fi

case "$runtime" in
  /*) ;;
  *) printf '%s\n' 'ONECREW_CONTAINER_RUNTIME must be an absolute executable path.' >&2; exit 64 ;;
esac
if [ ! -f "$runtime" ] || [ ! -x "$runtime" ]; then
  printf '%s\n' 'The configured container runtime is unavailable.' >&2
  exit 127
fi

exec "$runtime" exec -i "${ONECREW_CONTAINER_NAME:-onecrew-pro}" node /app/dist/cli.js mcp
