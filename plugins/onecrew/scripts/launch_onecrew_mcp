#!/bin/sh
set -eu

runtime=${ONECREW_DESKTOP_RUNTIME:-}
if [ -z "$runtime" ]; then
  for application in '/Applications/OneCrew Pro Preview.app' "$HOME/Applications/OneCrew Pro Preview.app"; do
    candidate="$application/Contents/Resources/onecrew-runtime"
    if [ -x "$candidate/bin/node" ] && [ -f "$candidate/dist/cli.js" ]; then
      runtime=$candidate
      break
    fi
  done
fi
data_dir=${ONECREW_DATA_DIR:-"$HOME/Library/Application Support/OneCrewProPreview/data"}
case "$runtime" in
  /*) ;;
  *) printf '%s\n' 'Locate the installed OneCrew Pro app and set ONECREW_DESKTOP_RUNTIME to its absolute onecrew-runtime directory.' >&2; exit 127 ;;
esac
case "$data_dir" in
  /*) ;;
  *) printf '%s\n' 'ONECREW_DATA_DIR must be an absolute path.' >&2; exit 64 ;;
esac
if [ ! -x "$runtime/bin/node" ] || [ ! -f "$runtime/dist/cli.js" ]; then
  printf '%s\n' 'The desktop MCP runtime is missing. Reinstall OneCrew Pro from its download page.' >&2
  exit 127
fi
cd /
exec "$runtime/bin/node" "$runtime/dist/cli.js" mcp --data-dir "$data_dir"
